+/// Under WSL the host terminal is usually Windows Terminal, which opens
+/// `file://` links only to Windows drive paths or `\\wsl.localhost` shares,
+/// not to Linux paths. Rewrite `file:///home/...` to
+/// `file://wsl.localhost/<distro>/home/...` and `file:///mnt/c/...` to
+/// `file:///C:/...` so links from programs in panes open on Windows. A Linux
+/// path that is a symlink into `/mnt/<drive>` (e.g. `~/notes` pointing at a
+/// Windows folder) is followed first: Windows can't follow it through the
+/// share, so it links to the drive path instead.
+fn wsl_host_file_uri(uri: String) -> String {
+    use std::collections::HashMap;
+    use std::sync::{Mutex, OnceLock};
+    static DISTRO: OnceLock<Option<String>> = OnceLock::new();
+    // Links are sanitized on every frame; resolve each one once.
+    static CACHE: OnceLock<Mutex<HashMap<String, String>>> = OnceLock::new();
+    let distro = DISTRO.get_or_init(|| {
+        std::env::var("WSL_DISTRO_NAME")
+            .ok()
+            .filter(|name| !name.is_empty())
+    });
+    let Some(distro) = distro else {
+        return uri;
+    };
+    if !uri.get(..7).is_some_and(|s| s.eq_ignore_ascii_case("file://")) {
+        return uri;
+    }
+    let cache = CACHE.get_or_init(|| Mutex::new(HashMap::new()));
+    if let Some(hit) = cache.lock().ok().and_then(|c| c.get(&uri).cloned()) {
+        return hit;
+    }
+    let resolved = resolve_into_drive(&uri, distro, |path| std::fs::canonicalize(path).ok());
+    let out = rewrite_wsl_file_uri(resolved.as_deref().unwrap_or(&uri), distro)
+        .unwrap_or_else(|| uri.clone());
+    if let Ok(mut c) = cache.lock() {
+        if c.len() >= 512 {
+            c.clear();
+        }
+        c.insert(uri, out.clone());
+    }
+    out
+}
