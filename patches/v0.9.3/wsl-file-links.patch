+/// For a `file://` link to a Linux path (local, or this distro's
+/// `wsl.localhost`/`wsl$` share) whose real location is under `/mnt/`, return
+/// a local link to that real location; otherwise `None`. Claude Code, for one,
+/// writes its file links in the `wsl.localhost` form itself.
+#[cfg(unix)]
+fn resolve_into_drive(
+    uri: &str,
+    distro: &str,
+    canonicalize: impl Fn(&std::path::Path) -> Option<std::path::PathBuf>,
+) -> Option<String> {
+    use std::os::unix::ffi::{OsStrExt, OsStringExt};
+    let rest = uri.get(7..)?;
+    let path = match share_path(rest, distro) {
+        Some(path) => {
+            // Already a share link: a /mnt/<drive> path only needs the drive form.
+            if path.starts_with("/mnt/") {
+                return Some(format!("file://{path}"));
+            }
+            path
+        }
+        None => rest.strip_prefix("localhost").unwrap_or(rest),
+    };
+    if !path.starts_with('/') || path.starts_with("/mnt/") {
+        return None;
+    }
+    let (path, suffix) = path.split_at(path.find(['?', '#']).unwrap_or(path.len()));
+    let decoded = std::ffi::OsString::from_vec(percent_decode(path));
+    let real = canonicalize(std::path::Path::new(&decoded))?;
+    let real = real.as_os_str().as_bytes();
+    real.starts_with(b"/mnt/")
+        .then(|| format!("file://{}{suffix}", percent_encode_path(real)))
+}
+
+/// The Linux path in `wsl.localhost/<distro>/...` or `wsl$/<distro>/...`, when
+/// `<distro>` is this one.
+fn share_path<'a>(rest: &'a str, distro: &str) -> Option<&'a str> {
+    let host_len = rest.find('/')?;
+    let host = &rest[..host_len];
+    if !host.eq_ignore_ascii_case("wsl.localhost") && !host.eq_ignore_ascii_case("wsl$") {
+        return None;
+    }
+    let after = &rest[host_len + 1..];
+    let name_len = after.find('/').unwrap_or(after.len());
+    let name = String::from_utf8(percent_decode(&after[..name_len])).ok()?;
+    if !name.eq_ignore_ascii_case(distro) {
+        return None;
+    }
+    let path = &after[name_len..];
+    Some(if path.is_empty() { "/" } else { path })
+}
+
+#[cfg(not(unix))]
+fn resolve_into_drive(
+    _uri: &str,
+    _distro: &str,
+    _canonicalize: impl Fn(&std::path::Path) -> Option<std::path::PathBuf>,
+) -> Option<String> {
+    None
+}
+
+fn percent_decode(text: &str) -> Vec<u8> {
+    let bytes = text.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b'%' {
+            if let Some(byte) = text.get(i + 1..i + 3).and_then(|h| u8::from_str_radix(h, 16).ok()) {
+                out.push(byte);
+                i += 3;
+                continue;
+            }
+        }
+        out.push(bytes[i]);
+        i += 1;
+    }
+    out
+}
+
+fn percent_encode_path(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len());
+    for &b in bytes {
+        if b.is_ascii_alphanumeric() || b"/-._~!$&'()*+,;=:@".contains(&b) {
+            out.push(b as char);
+        } else {
+            out.push_str(&format!("%{b:02X}"));
+        }
+    }
+    out
+}
+
+fn rewrite_wsl_file_uri(uri: &str, distro: &str) -> Option<String> {
+    let scheme = uri.get(..7)?;
+    if !scheme.eq_ignore_ascii_case("file://") {
+        return None;
+    }
+    let rest = &uri[7..];
+    // Only local paths: an empty host or "localhost". Other hosts (including
+    // wsl.localhost) and drive paths are already understood.
+    let path = rest.strip_prefix("localhost").unwrap_or(rest);
+    let bytes = path.as_bytes();
+    if bytes.first() != Some(&b'/') {
+        return None;
+    }
+    if bytes.len() >= 3 && bytes[1].is_ascii_alphabetic() && matches!(bytes[2], b':' | b'|') {
+        return None;
+    }
+    if let Some(drive_path) = path.strip_prefix("/mnt/") {
+        let mut chars = drive_path.chars();
+        if let (Some(letter), next) = (chars.next(), chars.next()) {
+            if letter.is_ascii_alphabetic() && matches!(next, None | Some('/')) {
+                let tail = &drive_path[1..];
+                let tail = if tail.is_empty() { "/" } else { tail };
+                return Some(format!("file:///{}:{tail}", letter.to_ascii_uppercase()));
+            }
+        }
+    }
+    Some(format!("file://wsl.localhost/{}{path}", distro.replace(' ', "%20")))
 }
 
