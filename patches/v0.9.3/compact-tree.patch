+        assert_eq!(tree.group_rest, "│ ");
+        assert_eq!(tree.child_first, "├─ ");
+        assert_eq!(tree.child_rest, "│  ");
+        let defaults = SpaceTreeConfig::default();
+        assert_eq!(tree.top_rest, defaults.top_rest);
+        assert_eq!(tree.last_child_first, defaults.last_child_first);
+        assert_eq!(tree.last_child_rest, defaults.last_child_rest);
+        assert_eq!(
+            config.ui.sidebar.spaces.rows,
+            SpacesSidebarConfig::default().rows
+        );
+    }
