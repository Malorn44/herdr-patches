+/// Text drawn before each line of a Space entry in the expanded sidebar.
+/// The defaults are Herdr's built-in tree; override any of them in
+/// `[ui.sidebar.spaces.tree]` for a more compact one.
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(default)]
+pub struct SpaceTreeConfig {
+    /// First line of a top-level Space.
+    pub top_first: String,
+    /// Later lines of a top-level Space without visible worktree children.
+    pub top_rest: String,
+    /// Later lines of a top-level Space whose worktree children are shown.
+    pub group_rest: String,
+    /// First line of a worktree child.
+    pub child_first: String,
+    /// First line of the last worktree child.
+    pub last_child_first: String,
+    /// Later lines of a worktree child.
+    pub child_rest: String,
+    /// Later lines of the last worktree child.
+    pub last_child_rest: String,
+}
+
+impl Default for SpaceTreeConfig {
+    fn default() -> Self {
+        Self {
+            top_first: " ".into(),
+            top_rest: "   ".into(),
+            group_rest: "   ".into(),
+            child_first: "   ├─ ".into(),
+            last_child_first: "   └─ ".into(),
+            child_rest: "   │    ".into(),
+            last_child_rest: "        ".into(),
         }
     }
 }
